@model QuanLyNhanSu.Models.PhongBan

@{
    ViewData["Title"] = "Chỉnh sửa phòng ban";
}

<div class="container-fluid p-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Chỉnh sửa thông tin phòng ban</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaPhong" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mã phòng</label>
                            <input type="text" class="form-control bg-light" value="#@Model.MaPhong" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên phòng ban <span class="text-danger">*</span></label>
                            <input asp-for="TenPhong" class="form-control" required />
                            <span asp-validation-for="TenPhong" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả chức năng</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-4">Cập nhật</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>