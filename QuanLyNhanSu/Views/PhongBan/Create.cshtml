@model QuanLyNhanSu.Models.PhongBan

@{
    ViewData["Title"] = "Thêm phòng ban";
}

<div class="container-fluid p-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Thêm phòng ban mới</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên phòng ban <span class="text-danger">*</span></label>
                            <input asp-for="TenPhong" class="form-control" placeholder="Ví dụ: Phòng Kỹ thuật, Phòng Nhân sự..." required />
                            <span asp-validation-for="TenPhong" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả chức năng</label>
                            <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập mô tả ngắn gọn về nhiệm vụ của phòng ban..."></textarea>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-4">Lưu phòng ban</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>