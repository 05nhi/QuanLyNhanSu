@model IEnumerable<QuanLyNhanSu.Models.NhanVien>

@{
    ViewData["Title"] = "Danh Bạ Nhân Viên";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible" role="alert">
        <div class="alert-message">@TempData["Success"]</div>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>DANH BẠ NHÂN VIÊN NỘI BỘ</h2>
        <a asp-action="Create" class="btn btn-success">+ Thêm nhân viên mới</a>
    </div>

    <!-- Thanh tìm kiếm -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text" name="searchString" class="form-control" placeholder="Nhập tên hoặc số điện thoại để tìm kiếm..." />
            <button class="btn btn-primary" type="submit">Tìm kiếm</button>
        </div>
    </form>

    <table class="table table-striped table-hover border">
        <thead class="table-dark">
            <tr>
                <th>STT</th>
                <th>Họ và Tên</th>
                <th>Email</th>
                <th>Số Điện Thoại</th>
                <th>Chức Vụ</th>
                <th>Phòng Ban</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@stt</strong></td>
                    <td><strong>@item.HoTen</strong></td>
                    <td>@item.Email</td>
                    <td>@item.SoDienThoai</td>
                    <td>@item.ChucVu</td>
                    <td>@item.MaPhongNavigation?.TenPhong</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MaNv" class="btn btn-sm btn-warning">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.MaNv" class="btn btn-sm btn-danger">Xóa</a>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>