@model QuanLyNhanSu.Models.TaiKhoan

@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="container-fluid p-0">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Cập nhật & Đặt lại mật khẩu tài khoản</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Username" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên đăng nhập</label>
                            <input type="text" class="form-control bg-light" value="@Model.Username" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên hiển thị</label>
                            <input asp-for="HoTen" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Liên kết hồ sơ nhân viên</label>
                            <select asp-for="MaNv" class="form-select" asp-items="ViewBag.MaNv">
                                <option value="">-- Không liên kết nhân viên --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Vai trò (Role)</label>
                            <select asp-for="Role" class="form-select">
                                <option value="User">User (Nhân viên thông thường)</option>
                                <option value="Admin">Admin (Quản trị viên)</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>